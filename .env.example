# Nur für lokale Entwicklung. Dieses Beispielkennwort ist ausdrücklich nicht produktiv;
# vor einem produktiven Einsatz muss ein eigenes sicheres Secret gesetzt werden.
POSTGRES_DB=kuechenfuchs
POSTGRES_USER=kuechenfuchs
POSTGRES_PASSWORD=local-development-only
HTTP_PORT=8080

# Nur für den einmaligen Bootstrap-Container. Nach erfolgreichem Bootstrap aus .env entfernen.
# Vor dem Bootstrap setzen; Passwort erzeugen mit: openssl rand -base64 32
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_HOUSEHOLD_NAME=Unser Zuhause

# KI-Rezeptentwürfe bleiben deaktiviert, bis Modell, API-Key, Tarif und Kostenlimit
# bewusst gesetzt wurden. Preise in USD je 1 Million Tokens gemäß OpenAI-Preisseite
# zum Nutzungszeitpunkt eintragen; keine Preise dauerhaft aus diesem Beispiel übernehmen.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_MONTHLY_BUDGET_USD=0
AI_INPUT_USD_PER_MILLION_TOKENS=0
AI_OUTPUT_USD_PER_MILLION_TOKENS=0
AI_REQUESTS_PER_MINUTE_PER_USER=8
AI_MAX_MONTHLY_REQUESTS_PER_HOUSEHOLD=100
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=1500
AI_TIMEOUT_SECONDS=30
AI_RESERVATION_EXPIRATION_SECONDS=180
AI_MAX_PROMPT_CHARACTERS=2000

# Keycloak / ChatGPT-OAuth (P5a), nur mit compose.keycloak.yaml (Heimserver zusätzlich compose.homeserver.yaml).
# Alle Secrets sind Pflicht und werden lokal erzeugt, z. B. mit: openssl rand -base64 48 | tr -d '\n/+='
# Keine produktiven Secrets in Beispiel- oder Testdateien. Keycloak ist öffentlich nur unter
# ${KUECHENFUCHS_PUBLIC_URL}/auth erreichbar; die Admin-Konsole nur über 127.0.0.1:${KEYCLOAK_ADMIN_PORT}.
# Lokal leer lassen (dann http://localhost:${HTTP_PORT}); Heimserver: https://kuechenfuchs.zaddach.org
KUECHENFUCHS_PUBLIC_URL=
# Nur ändern, wenn ein containerisierter Heimserver-Caddy den Web-Port über die Docker-Bridge erreichen muss.
HTTP_BIND_ADDRESS=127.0.0.1
KEYCLOAK_ADMIN_PORT=8180
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=kuechenfuchs-admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_LINK_CLIENT_SECRET=
KEYCLOAK_CHATGPT_ACTIONS_CLIENT_SECRET=
KEYCLOAK_API_ADMIN_CLIENT_SECRET=
CHATGPT_BEARER_REQUESTS_PER_MINUTE=60
